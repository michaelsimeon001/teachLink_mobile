EXPO_PUBLIC_API_BASE_URL=https://api.teachlink.com
EXPO_PUBLIC_SOCKET_URL=wss://api.teachlink.com
EXPO_PUBLIC_APP_ENV=production

# Sentry. Replace the example DSN with the project DSN in EAS Secrets.
EXPO_PUBLIC_SENTRY_ENABLED=true
EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@sentry.io/0

# Push Notifications
# For production, configure these in EAS Build
# EXPO_PUBLIC_PUSH_TOKEN_URL=https://exp.host/--/api/v2/push/send

# Feature Flags
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_STORYBOOK=false

# Development-only performance demo setting. Leave unset for normal use.
# EXPO_PUBLIC_LAZY_LOAD_DELAY_MS=1500
